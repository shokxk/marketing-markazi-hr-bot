# Server & Port
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
ADMIN_PANEL_URL=http://localhost:3000

# Telegram Bot
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ
HR_TELEGRAM_GROUP_ID=-100123456789

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketing_hr_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# amoCRM Configuration
AMOCRM_SUBDOMAIN=marketingmarkazi
AMOCRM_CLIENT_ID=your_client_id_here
AMOCRM_CLIENT_SECRET=your_client_secret_here
AMOCRM_REDIRECT_URI=http://localhost:4000/api/amocrm/callback
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_INITIAL_STATUS_ID=

# Storage (Local or S3/MinIO)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=candidate-videos
